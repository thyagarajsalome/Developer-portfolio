---
import content from '../data/content.json';
---
<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title">Experience</h2>
    <div class="experience-list flex flex-col gap-8">
      {content.experiences.map((exp) => (
        <div class="experience-item glass">
          <div class="exp-header flex justify-between items-center">
            <div>
              <h3 class="exp-role">{exp.role}</h3>
              <div class="exp-company text-gradient">{exp.company}</div>
            </div>
            <div class="exp-period">{exp.period}</div>
          </div>
          <ul class="exp-bullets">
            {exp.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }
  .experience-item {
    padding: 2.5rem;
  }
  .exp-header {
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .exp-role {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .exp-company {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .exp-period {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .exp-bullets {
    list-style-type: none;
    padding-left: 0;
  }
  .exp-bullets li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }
  .exp-bullets li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
  }
</style>
