---
import content from '../data/content.json';
---
<section id="skills" class="section">
  <div class="container">
    <div class="skills-header text-center mb-12">
      <h2 class="section-title">Technical Expertise</h2>
      <p class="skills-subtitle">Bridging the gap between traditional software engineering and next-generation AI agents to ship products faster without compromising quality.</p>
    </div>
    
    <div class="skills-grid">
      {content.skills.map((category) => (
        <div class="skill-category glass">
          <h3 class="category-title text-gradient">{category.title}</h3>
          <ul class="skill-list">
            {category.skills.map((skill) => (
              <li class="skill-item">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .mb-12 {
    margin-bottom: 3rem;
  }
  .skills-subtitle {
    color: var(--text-secondary);
    max-width: 48rem;
    margin: 0 auto;
    font-size: 1.1rem;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  .skill-category {
    padding: 2rem;
  }
  .category-title {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .skill-list {
    list-style-type: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .skill-item {
    font-weight: 500;
    color: var(--text-primary);
    position: relative;
    padding-left: 1.5rem;
  }
  .skill-item::before {
    content: '.';
    position: absolute;
    left: 0;
    color: var(--accent-secondary);
  }
</style>
